{
  "name": "typeout",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "$properties": {
        "CameraMode": "LockFirstPerson",
        "EnableMouseLockOption": false
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "$path": "workspace",
      "$ignoreUnknownInstances": true,
      "$properties": {
        "FilteringEnabled": true
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [0.3, 0.32, 0.38],
        "OutdoorAmbient": [0.55, 0.6, 0.68],
        "Brightness": 2.5,
        "ClockTime": 14,
        "GeographicLatitude": 30,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.25,
          "Offset": 0.25,
          "Color": [0.78, 0.87, 1],
          "Decay": [0.62, 0.78, 1],
          "Glare": 0,
          "Haze": 1
        }
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}